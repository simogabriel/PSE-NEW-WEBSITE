/* Match the Team template's base layout rules within this footer only. */
#pse-reference-footer footer { font: 12px sans-serif; }
#pse-reference-footer *, #pse-reference-footer *::before, #pse-reference-footer *::after { box-sizing: border-box; }
#pse-reference-footer [data-framer-component-type="RichTextContainer"] { display:flex; flex-direction:column; }
