.pse-nav {
  box-sizing: border-box;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 2147482000;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: clamp(20px, 3vw, 44px);
  padding: 0 clamp(16px, 4vw, 56px);
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid transparent;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
  transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
}
.pse-nav *,
.pse-nav *::before,
.pse-nav *::after { box-sizing: border-box; }
.pse-nav.is-scrolled {
  border-bottom-color: rgba(22, 20, 42, 0.08);
  box-shadow: 0 6px 24px rgba(22, 20, 42, 0.06);
}

.pse-nav__brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.pse-nav__brand img { height: 34px; width: auto; display: block; }

.pse-nav__links {
  display: flex;
  align-items: center;
  gap: clamp(14px, 2vw, 30px);
  margin: 0; padding: 0; list-style: none;
}
.pse-nav__links a {
  text-decoration: none;
  color: #16142a;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  transition: color .2s ease;
  white-space: nowrap;
}
.pse-nav__links a:hover,
.pse-nav__links a.is-active { color: #348ace; }


.pse-nav__right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; margin-left: auto; }


.pse-nav__lang {
  display: inline-flex; gap: 2px;
  border: 1px solid rgba(22,20,42,.12);
  border-radius: 999px; padding: 3px; background: #fff;
}
.pse-nav__lang button {
  border: 0; background: transparent; cursor: pointer;
  font-size: 12px; font-weight: 700; color: #6b6b80;
  padding: 6px 10px; border-radius: 999px; line-height: 1; transition: .2s;
}
.pse-nav__lang button:hover { color: #348ace; }
.pse-nav__lang button.is-active { background: #348ace; color: #fff; }


.pse-nav__theme {
  position: relative;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  border: 1px solid rgba(22, 20, 42, .12);
  border-radius: 999px;
  background: rgba(255, 255, 255, .92);
  color: #16142a;
  cursor: pointer;
  overflow: hidden;
  transition: color .25s ease, background .25s ease, border-color .25s ease, transform .25s ease;
}
.pse-nav__theme:hover { color: #1677c8; transform: translateY(-1px); }
.pse-nav__theme span {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font-size: 19px;
  line-height: 1;
  transition: opacity .25s ease, transform .25s ease;
}
.pse-nav__theme-moon { opacity: 1; transform: rotate(0) scale(1); }
.pse-nav__theme-sun { opacity: 0; transform: rotate(-45deg) scale(.65); }
[data-pse-theme="dark"] .pse-nav__theme-moon { opacity: 0; transform: rotate(45deg) scale(.65); }
[data-pse-theme="dark"] .pse-nav__theme-sun { opacity: 1; transform: rotate(0) scale(1); }

