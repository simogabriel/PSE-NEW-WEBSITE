/* ---------------- BOUTONS du template (pastilles "Button Fill") ----
   NOIR à la base, BLEU au survol, contenu (texte + flèche) en blanc. */
[data-framer-name="Button Fill"] {
  background-color: #000 !important;
  transition: background-color .2s ease !important;
}
/* contenu du bouton en blanc (texte + icônes), via le parent qui
   contient la pastille */
*:has(> [data-framer-name="Button Fill"]) p,
*:has(> [data-framer-name="Button Fill"]) .framer-text,
*:has([data-framer-name="Button Fill"]) [data-framer-name*="Arrow"] {
  --framer-text-color: #fff !important;
  color: #fff !important;
  fill: #fff !important;
}
/* survol : la pastille passe au bleu */
*:has(> [data-framer-name="Button Fill"]):hover > [data-framer-name="Button Fill"] {
  background-color: #348ace !important;
}
