/* TEXTES des cartes Actualités RETIRÉS partout (accueil + blog.html) tant
   qu'on n'a pas les vrais titres/dates : on masque tout le bloc texte
   (« Blog Content » = titre + date + durée) ET l'overlay « Lire la suite »
   (« Read More Wrap »). -> cartes = PHOTO seule. (Retirer ces règles pour
   remontrer les textes plus tard.) Cible : cartes d'articles uniquement
   (liens vers blog…), pas les pages d'article elles-mêmes. */
a[href*="blog"] [data-framer-name="Blog Content"],
a[href*="blog"] [data-framer-name="Read More Wrap"],
.pse-news-card [data-framer-name="Blog Content"],
.pse-news-card [data-framer-name="Read More Wrap"] { display: none !important; }

/* ================================================================
 *  PHOTOS PSE des cartes d'articles — posées en FOND via CSS.
 *
 *  POURQUOI EN CSS : Framer reconstruit le DOM après hydratation et
 *  EFFACE tout ce que le JS modifie (l'<img> revenait au template ->
 *  « l'image disparaît / revient comme avant »). Une règle CSS, elle,
 *  continue de s'appliquer après chaque reconstruction. On cible par
 *  le lien de l'article (href, stable) : robuste à 100 %.
 *  Vaut pour blog.html ET le carrousel Actualités de l'accueil.
 *  url() est relative à CE fichier (pse-custom/) -> "news/…".
 * ================================================================ */
[href*="ai-transforms-manufacturing"]             [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-1.jpg") !important; }
[href*="bridging-the-manufacturing-skills-gap"]   [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-2.jpg") !important; }
[href*="data-driven-manufacturing"]               [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-3.jpg") !important; }
[href*="predictive-maintenance-the-game-changer"] [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-4.jpg") !important; }
[href*="sustainable-manufacturing-solutions"]     [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-5.jpg") !important; }
[href*="this-is-a-bloh-headline-title"]           [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-6.jpg") !important; }
.pse-news-photo7                                  [data-framer-name="Blog Image Wrap"] { background-image: url("news/news-7.jpg") !important; }

/* Cadrage commun + on masque l'<img> du template (la photo PSE est en fond) */
[href*="blog/"] [data-framer-name="Blog Image Wrap"],
.pse-news-photo7 [data-framer-name="Blog Image Wrap"] {
  background-color: transparent !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  border: 0 !important;
  box-shadow: none !important;
}
[href*="blog/"] [data-framer-name="Blog Image Wrap"] img,
.pse-news-photo7 [data-framer-name="Blog Image Wrap"] img { opacity: 0 !important; }

/* Flottement sobre : une seule ombre douce, sans empilement proéminent. */
.pse-news-card {
  transition: transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease;
}
.pse-news-card:hover {
  transform: translateY(-11px);
  box-shadow: none !important;
}

@media (max-width: 809px) {
  .pse-news-card {
    --pse-news-frame-width: 5px;
    padding: 0 !important;
  }
}

/* 4) Barre de contrôle : boutons ronds ‹ › alignés à droite (bas). */
.pse-news-controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
  margin-top: 30px;
}
.pse-news-nav {
  width: 50px; height: 50px;
  flex: 0 0 auto;
  border-radius: 999px;
