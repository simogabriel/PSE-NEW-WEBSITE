/* ================================================================
 *  AMÉLIORATIONS PSE  —  Navigation + animation du héros
 * ================================================================ */

/* Masque l'ancienne barre Framer (sera fait aussi en JS, ceinture+bretelles) */
.pse-framer-hidden { display: none !important; }

/* Décale le contenu pour laisser la place à la nav fixe */
.pse-has-nav #main { padding-top: 76px; }

/* ---------------- NAVIGATION ---------------- */
.pse-nav {
  box-sizing: border-box;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 2147482000;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: clamp(20px, 3vw, 44px);
  padding: 0 clamp(16px, 4vw, 56px);
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid transparent;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
  transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
}
.pse-nav *,
.pse-nav *::before,
.pse-nav *::after { box-sizing: border-box; }
.pse-nav.is-scrolled {
  border-bottom-color: rgba(22, 20, 42, 0.08);
  box-shadow: 0 6px 24px rgba(22, 20, 42, 0.06);
}

.pse-nav__brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.pse-nav__brand img { height: 34px; width: auto; display: block; }

.pse-nav__links {
  display: flex;
  align-items: center;
  gap: clamp(14px, 2vw, 30px);
  margin: 0; padding: 0; list-style: none;
}
.pse-nav__links a {
  text-decoration: none;
  color: #16142a;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  transition: color .2s ease;
  white-space: nowrap;
}
.pse-nav__links a:hover,
.pse-nav__links a.is-active { color: #348ace; }

/* pousse le bloc langue + contact tout à droite (logo + menu restent groupés à gauche) */
.pse-nav__right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; margin-left: auto; }

/* Sélecteur de langue intégré */
.pse-nav__lang {
  display: inline-flex; gap: 2px;
  border: 1px solid rgba(22,20,42,.12);
  border-radius: 999px; padding: 3px; background: #fff;
}
.pse-nav__lang button {
  border: 0; background: transparent; cursor: pointer;
  font-size: 12px; font-weight: 700; color: #6b6b80;
  padding: 6px 10px; border-radius: 999px; line-height: 1; transition: .2s;
}
.pse-nav__lang button:hover { color: #348ace; }
.pse-nav__lang button.is-active { background: #348ace; color: #fff; }

/* Shared light/dark theme control. */
.pse-nav__theme {
  position: relative;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  border: 1px solid rgba(22, 20, 42, .12);
  border-radius: 999px;
  background: rgba(255, 255, 255, .92);
  color: #16142a;
  cursor: pointer;
  overflow: hidden;
  transition: color .25s ease, background .25s ease, border-color .25s ease, transform .25s ease;
}
.pse-nav__theme:hover { color: #1677c8; transform: translateY(-1px); }
.pse-nav__theme span {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font-size: 19px;
  line-height: 1;
  transition: opacity .25s ease, transform .25s ease;
}
.pse-nav__theme-moon { opacity: 1; transform: rotate(0) scale(1); }
.pse-nav__theme-sun { opacity: 0; transform: rotate(-45deg) scale(.65); }
[data-pse-theme="dark"] .pse-nav__theme-moon { opacity: 0; transform: rotate(45deg) scale(.65); }
[data-pse-theme="dark"] .pse-nav__theme-sun { opacity: 1; transform: rotate(0) scale(1); }

html[data-pse-theme="dark"] body {
  --token-fa8bc3f4-ff3b-4ade-9ba6-2b90ee4d37f3: #edf4ff;
  --token-85e42553-644e-4254-88a7-c81ac840c5d2: #f6f9ff;
  --token-8328fbec-38f5-4ae3-b863-b572a6da0fce: #dbe7f5;
  --token-1fa38b65-d550-48ba-89e2-94fe63443ed4: #071321;
  --token-144e382c-cd5b-4ed7-9684-9db9c45475a1: #bdcada;
  --token-fe8c69ce-4adb-45ec-b660-1650dac6774f: #0d1d2d;
  --token-4904ad93-0af3-4d66-8943-5858e4bdc968: #07111f;
  background: #071321 !important;
  color: #edf4ff;
}
html[data-pse-theme="dark"] #main,
html[data-pse-theme="dark"] [data-framer-root] {
  background-color: #071321 !important;
}
html[data-pse-theme="dark"] .pse-nav {
  background: rgba(7, 19, 33, .86);
  border-bottom-color: rgba(142, 194, 255, .16);
  box-shadow: 0 8px 28px rgba(0, 0, 0, .24);
}
html[data-pse-theme="dark"] .pse-nav__links a { color: #eaf2fc; }
html[data-pse-theme="dark"] .pse-nav__links a:hover,
html[data-pse-theme="dark"] .pse-nav__links a.is-active { color: #68b8ff; }
html[data-pse-theme="dark"] .pse-nav__lang,
html[data-pse-theme="dark"] .pse-nav__theme,
html[data-pse-theme="dark"] .pse-nav__burger {
  color: #eef6ff;
  background: #102438;
  border-color: rgba(142, 194, 255, .22);
}
html[data-pse-theme="dark"] .pse-nav__lang button { color: #bdcada; }
html[data-pse-theme="dark"] .pse-nav__lang button.is-active { color: #fff; background: #1677c8; }
html[data-pse-theme="dark"] .pse-nav__burger span,
html[data-pse-theme="dark"] .pse-nav__burger span::before,
html[data-pse-theme="dark"] .pse-nav__burger span::after { background: #eef6ff; }
html[data-pse-theme="dark"] .pse-nav.is-open .pse-nav__burger span { background: transparent; }
html[data-pse-theme="dark"] input,
html[data-pse-theme="dark"] textarea,
html[data-pse-theme="dark"] select {
  color: #edf4ff !important;
  background-color: #102438 !important;
  border-color: rgba(142, 194, 255, .24) !important;
}
html[data-pse-theme="dark"] input::placeholder,
html[data-pse-theme="dark"] textarea::placeholder { color: #91a4ba !important; }

@media (max-width: 900px) {
  html[data-pse-theme="dark"] .pse-nav__links { background: #071321; }
  .pse-nav__right { gap: 8px; }
  .pse-nav__theme { width: 36px; height: 36px; flex-basis: 36px; }
}

@media (max-width: 520px) {
  .pse-nav { gap: 10px; padding-inline: 12px; }
  .pse-nav__brand img { height: 28px; }
  .pse-nav__lang button { padding: 6px 7px; }
}

/* Theme surface fallbacks for Framer blocks that use literal light colours. */
html[data-pse-theme="dark"] #hero-section,
html[data-pse-theme="dark"] section:not([data-framer-name="Section Blog Header"]):not([data-framer-name="Section Solutions Header"]):not([data-framer-name="Section Team Image"]):not([data-framer-name="Section Team Header"]) {
  background-color: #071321 !important;
}
html[data-pse-theme="dark"] #hero-section h1,
html[data-pse-theme="dark"] #hero-section h2,
html[data-pse-theme="dark"] #hero-section h3,
html[data-pse-theme="dark"] #hero-section p {
  --framer-text-color: #edf4ff !important;
  color: #edf4ff !important;
}
html[data-pse-theme="dark"] section:not([data-framer-name="Section Blog Header"]):not([data-framer-name="Section Solutions Header"]) .framer-text {
  color: var(--framer-text-color, #edf4ff);
}

/* Dark-mode readability for cards and custom page components. Images are
   deliberately excluded: their source, crop, opacity and colours stay intact. */
html[data-pse-theme="dark"] section .framer-text:not(.pse-carousel-image-caption),
html[data-pse-theme="dark"] .pse-mission-visible-copy,
html[data-pse-theme="dark"] .pse-mission-visible-copy p,
html[data-pse-theme="dark"] .pse-team-name {
  --framer-text-color: #edf4ff !important;
  color: #edf4ff !important;
}
html[data-pse-theme="dark"] a:not(.pse-nav__brand) { color: #8ecaff; }
html[data-pse-theme="dark"] [data-framer-name*="Card"] {
  border-color: rgba(142, 194, 255, .18) !important;
}
html[data-pse-theme="dark"] .pse-news-nav,
html[data-pse-theme="dark"] .pse-news-nav:disabled {
  color: #edf4ff;
  background: #102438;
  border-color: rgba(142, 194, 255, .25);
}
html[data-pse-theme="dark"] .pse-news-nav:hover {
  color: #fff;
  background: #1677c8;
  border-color: #1677c8;
}
html[data-pse-theme="dark"] .ref-stat,
html[data-pse-theme="dark"] .ref-stat--hero,
html[data-pse-theme="dark"] .ref-stat--chips span,
html[data-pse-theme="dark"] .ref-card__body,
html[data-pse-theme="dark"] .ref-card__media {
  color: #edf4ff !important;
  background: #102438 !important;
  border-color: rgba(142, 194, 255, .18) !important;
}
html[data-pse-theme="dark"] .pse-ref-page {
  --ref-ink: #edf4ff;
  --ref-muted: #aebed0;
  --ref-line: rgba(142, 194, 255, .18);
  --ref-soft: #0d1d2d;
  --ref-accent-soft: #132d46;
  color-scheme: dark;
  color: #edf4ff !important;
  background: #071321 !important;
}
html[data-pse-theme="dark"] .ref-lead,
html[data-pse-theme="dark"] .ref-stat__label,
html[data-pse-theme="dark"] .ref-stat__sub,
html[data-pse-theme="dark"] .ref-card p {
  color: #bdcada !important;
}

/* Bouton contact */
.pse-nav__cta {
  text-decoration: none;
  background: #000; color: #fff;
  font-size: 14px; font-weight: 600;
  padding: 10px 18px; border-radius: 999px;
  transition: transform .2s ease, background .2s ease;
  white-space: nowrap;
}
.pse-nav__cta:hover { background: #348ace; transform: translateY(-1px); }

/* Hamburger (mobile) */
.pse-nav__burger {
  display: none;
  width: 44px; height: 44px;
  border: 1px solid rgba(22,20,42,.12);
  border-radius: 10px; background: #fff; position: relative; cursor: pointer;
}
.pse-nav__burger span,
.pse-nav__burger span::before,
.pse-nav__burger span::after {
  content: ""; position: absolute; left: 50%; top: 50%;
  width: 20px; height: 2px; background: #16142a; transition: .25s;
  transform: translate(-50%, -50%);
}
.pse-nav__burger span::before { transform: translate(-50%, -7px); }
.pse-nav__burger span::after  { transform: translate(-50%, 5px); }
.pse-nav.is-open .pse-nav__burger span { background: transparent; }
.pse-nav.is-open .pse-nav__burger span::before { transform: translate(-50%, 0) rotate(45deg); }
.pse-nav.is-open .pse-nav__burger span::after  { transform: translate(-50%, 0) rotate(-45deg); }

@media (max-width: 900px) {
  .pse-nav__burger { display: block; }
  .pse-nav__links {
    display: none;
    position: fixed; inset: 76px 0 0 0;
    flex-direction: column; align-items: flex-start; gap: 8px;
    background: #fff; padding: 24px clamp(16px, 5vw, 40px);
    overflow-y: auto;
  }
  .pse-nav.is-open .pse-nav__links { display: flex; }
  .pse-nav__links a { font-size: 19px; padding: 10px 0; }
  .pse-nav__cta { display: none; }
}

/* ---------------- HÉROS façon « Antigravity » ----------------
   Règles PERMANENTES (dans le <head>) : Framer reconstruit le héros
   après coup, donc ces styles ne doivent PAS vivre dans la section. */

/* On retire toute image de fond du héros (rayures « Hero Image », etc.)
   MAIS on garde notre logo .pse-hero-logo (sinon il est masqué aussi). */
[data-framer-name="Hero Image"],
#hero-section [data-framer-name="Image Wrapper"],
#hero-section img:not(.pse-hero-logo),
#hero-section video { display: none !important; }

/* Sécurité : notre logo doit toujours s'afficher */
#hero-section img.pse-hero-logo { display: block !important; }

/* ---- Sections masquées sur l'accueil (demande client) ----
   « Qui sommes-nous » (Section Intro), « Nos services » (Section Core Services)
   et le bloc à onglets « Notre expertise / Ce que nous faisons / Expertise
   technique / Notre expertise (partenariat) » (Section Offerings). */
[data-framer-name="Section Intro"],
[data-framer-name="Section Core Services"],
[data-framer-name="Section Offerings"] { display: none !important; }

/* ---- solutions.html : section services template (« Machinery Design » +
   FAQ) masquée — remplacée par l'accordéon PSE (services-grid.js). ---- */
[data-framer-name="Section Services Sticky"] { display: none !important; }

/* ---- Page À propos : section « Meet Our Leaders » masquée (demande client) ---- */
[data-framer-name="Section Our Leaders"] { display: none !important; }

/* ---- about.html : 2e image retirée (demande client) ----
   La colonne image de la section « Notre mission » (Section About Intro)
   — celle juste au-dessus des témoignages « Quelques mots de nos partenaires
   de confiance » — est masquée. Le texte « Notre mission » prend toute la
   largeur (on masque toute la colonne, pas juste l'<img>, pour éviter un vide).
   « Section  Image » a un DOUBLE espace dans son data-framer-name. */
[data-framer-name="Section About Intro"] [data-framer-name="Section  Image"] { display: none !important; }

/* ---- Page À propos : bloc image juste au-dessus des témoignages masqué
   (demande client). NB : le nom Framer contient un DOUBLE espace. ---- */
[data-framer-name="Section  Image"] { display: none !important; }

/* ---- Badges du template Framer retirés (Buy Template / Made in Framer) ---- */
[data-framer-name="Buy Template Module"],
[data-framer-name="Buy Template Button"],
[class*="__framer-badge"] { display: none !important; }

/* ---- Section « Nos étapes » (Our Proccss) : fond bleu nuit PLEIN (d'origine)
   + réseau de particules animé monté en fond par antigravity.js. ---- */
[data-framer-name="Section Our Proccss"] {
  position: relative;            /* repère pour le canvas de particules */
}
/* Le contenu (titre, étapes…) passe AU-DESSUS du canvas « antigravity ». */
[data-framer-name="Section Our Proccss"] > *:not(.pse-antigravity) {
  position: relative;
  z-index: 1;
}

/* ---- solutions.html : photo équipe dans la colonne « Solve Smarter » ----
   Image portrait recadrée proprement (cover), centrée sur les visages
   (haut-milieu). Ajuster le 2e % de object-position pour monter/descendre. */
#solve-smarter [data-framer-name="Image Wrap"] img,
#solve-smarter [data-framer-name="Image Wrap"] {
  object-fit: cover !important;
  object-position: center 30% !important;
}

/* ---- team.html : photo team-building dans la section citation (DG) ----
   Photo de groupe (paysage) : remplissage propre (cover), centrée sur la
   bande des visages. Si les côtés sont trop coupés, passer en `contain`. */
/* Image ENTIÈRE (contain) : on ne coupe NI les têtes NI les pieds.
   Les zones non couvertes (bandes) sont comblées en bleu nuit -> propre. */
#team-intro-1 [data-framer-name="Image Wrapper"] img {
  object-fit: contain !important;
  object-position: center !important;
}
#team-intro-1 [data-framer-name="Image"],
#team-intro-1 [data-framer-name="Image Wrapper"] {
  background-color: #0c2034 !important;
}
/* Hauteur de la section : assez haute pour que l'image (contain) soit grande. */
#team-intro-1 {
  padding-top: 220px !important;
  padding-bottom: 220px !important;
}

/* ---- team.html : section « Notre équipe dirigeante » (Section Team Header) ----
   Photo d'équipe PSE (plage) posée en FOND CSS -> survit aux reconstructions
   Framer (sinon l'image « disparaît / revient comme avant »). On masque l'<img>
   du template. url() relative à ce fichier (pse-custom/) -> "team/…". */
[data-framer-name="Section Team Header"] [data-framer-name="Image Wrapper"] {
  /* Voile dégradé sombre PAR-DESSUS la photo -> texte lisible.
     Plus sombre -> monter les alphas (0.30/0.55 -> 0.45/0.70 ...). */
  background-image:
    linear-gradient(180deg, rgba(8,18,30,0.30) 0%, rgba(8,18,30,0.40) 45%, rgba(8,18,30,0.62) 100%),
    url("team/leadership.jpg") !important;
  background-size: cover, cover !important;
  background-position: center, center 40% !important;
  background-repeat: no-repeat, no-repeat !important;
}
[data-framer-name="Section Team Header"] [data-framer-name="Image Wrapper"] img {
  opacity: 0 !important;
}

/* ---- Footer : même bleu nuit + mêmes particules animées ---- */
footer {
  position: relative;
  background-color: #0c2034 !important;   /* identique à la section « Nos étapes » */
}
footer > *:not(.pse-antigravity) {
  position: relative;
  z-index: 1;
}


/* ---- Photo d'équipe (section #image) : bandeau, légèrement dézoomé ----
   La section faisait 640px de haut -> l'image panoramique (large/basse)
   était trop recadrée (zoomée). On réduit la hauteur du bandeau pour
   montrer plus de l'image, en gardant un remplissage propre (cover). */
#image {
  height: 600px !important;
  max-height: 80vh !important;
  padding-top: 96px !important;
  padding-bottom: 96px !important;
}
/* Persistent team photo: the CSS background survives Framer's DOM rebuilds
   during navigation, while the template image underneath stays hidden. */
#image [data-framer-name="Image Wrapper"] {
  background-color: #0c1424 !important;
  background-image:
    linear-gradient(180deg, rgba(5, 13, 29, .18), rgba(5, 13, 29, .52)),
    url("pse-team.jpg?v=2") !important;
  background-position: center, center 42% !important;
  background-repeat: no-repeat, no-repeat !important;
  background-size: cover, cover !important;
}

#image [data-framer-name="Image Wrapper"] img {
  opacity: 0 !important;
  visibility: hidden !important;
}

#image [data-framer-name="Text Wrap"] {
  position: relative;
  z-index: 2;
  width: min(100%, 1100px) !important;
}

#image [data-framer-name="Text Wrap"] h2,
#image [data-framer-name="Text Wrap"] p {
  text-wrap: balance;
  text-shadow: 0 2px 18px rgba(0, 0, 0, .48);
}

@media (max-width: 809px) {
  #image {
    height: clamp(460px, 82vh, 620px) !important;
    max-height: none !important;
    padding: 72px 20px !important;
  }

  #image [data-framer-name="Image Wrapper"] {
    background-position: center, 58% center !important;
  }

  #image [data-framer-name="Text Wrap"] h2 {
    font-size: clamp(2rem, 9.5vw, 4rem) !important;
    line-height: 1.04 !important;
  }
}

/* ---- Effet machine à écrire au scroll (pse-custom/scroll-type.js) ----
   Le texte s'écrit lettre par lettre, suivi d'un curseur clignotant. */
.pse-tt-text { white-space: pre-wrap; }
.pse-tt-caret {
  display: inline-block;
  width: 2px;
  height: 1em;
  margin-left: 0.04em;
  vertical-align: -0.12em;
  background: currentColor;            /* curseur de la couleur du texte */
  animation: pse-blink 1s steps(1) infinite;
}
/* Le titre superposé à la photo (#image) reste lisible : curseur bleu marque */
#image .pse-tt-caret { background: #ffffff; }

/* Fond blanc */
#hero-section { background: #ffffff !important; }

/* Texte du héros en sombre pour rester lisible sur fond clair */
#hero-section h1,
#hero-section h2,
#hero-section h3,
#hero-section p {
  --framer-text-color: #16142a !important;
  color: #16142a !important;
}

/* Disposition CENTRÉE façon Antigravity : titre + sous-titre + bouton
   empilés et centrés (au lieu de « titre à gauche / carte à droite »). */
#hero-section { justify-content: center !important; align-items: center !important; }

#hero-section [data-framer-name="Container"],
#hero-section [data-framer-name="Content"] {
  width: 100% !important;
  max-width: 1080px !important;
  margin-inline: auto !important;
  align-items: center !important;
  text-align: center !important;
}

/* « Top » : la rangée devient une colonne centrée */
#hero-section [data-framer-name="Top"] {
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 38px !important;
  width: 100% !important;
  text-align: center !important;
}

#hero-section [data-framer-name="Headline Wrap"] {
  flex: none !important;
  width: 100% !important;
  max-width: 1000px !important;
  justify-content: center !important;
}

#hero-section h1 { text-align: center !important; width: 100% !important; }

/* ---- Contenu CUSTOM du héros (titre + sous-titre + bouton, centré) ----
   On masque tout le contenu Framer d'origine du héros et on affiche
   le nôtre (construit par pse-custom/hero-cta.js). */
#hero-section.pse-hero-custom [data-framer-name="Container"] { display: none !important; }

/* Le héros doit pouvoir GRANDIR pour afficher titre + boutons + stats sans
   rogner le contenu (sinon les stats sous les boutons sont coupées). */
#hero-section.pse-hero-custom {
  height: auto !important;
  min-height: 100vh;
  padding-top: clamp(110px, 15vh, 180px) !important;
  padding-bottom: clamp(56px, 9vh, 100px) !important;
  box-sizing: border-box;
}

.pse-hero {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 880px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 30px;
  /* police de TEXTE du template */
  font-family: "Inter", "Inter Placeholder", sans-serif;
}
/* Logo « pse CONSULTING » horizontal, centré au-dessus du titre.
   L'image a une marge blanche interne -> on dimensionne en largeur et
   on compense par des marges négatives pour un espacement régulier. */
.pse-hero-logo {
  width: clamp(170px, 20vw, 250px);
  height: auto;
  display: block;
  margin: 0 auto -16px; /* centré + écart réduit avec le titre */
}

.pse-hero h1 {
  margin: 0;
  /* police de TITRE du template */
  font-family: "Archivo", "Archivo Placeholder", sans-serif;
  font-size: clamp(46px, 6.8vw, 92px);
  line-height: 1.04;
  font-weight: 500; /* moins gras, comme le titre « Nos services » */
  letter-spacing: -0.025em;
  color: #16142a !important;
  min-height: 1.04em; /* évite le saut de mise en page pendant la frappe */
}

/* ---- Animation au chargement du héros ----
   Curseur de saisie (machine à écrire) sur le titre. */
.pse-hero .pse-caret {
  display: inline-block;
  width: 3px;
  height: 0.92em;
  margin-left: 0.06em;
  vertical-align: -0.10em;
  background: #348ace;            /* curseur bleu marque */
  animation: pse-blink 1s steps(1) infinite;
}
@keyframes pse-blink {
  0%, 50%    { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}

/* Logo puis bouton : montent du bas en fondu (le bouton est décalé en JS). */
.pse-hero .pse-reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 1s cubic-bezier(.22,.61,.36,1),
              transform 1s cubic-bezier(.22,.61,.36,1);
  will-change: opacity, transform;
}
.pse-hero .pse-reveal.is-in {
  opacity: 1;
  transform: none;
}

/* Accessibilité : pas d'animation si l'utilisateur la refuse. */
@media (prefers-reduced-motion: reduce) {
  .pse-hero .pse-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  .pse-hero .pse-caret { display: none !important; }
}
.pse-hero .pse-hero-sub {
  margin: 0;
  max-width: 600px;
  font-size: clamp(17px, 1.5vw, 20px);
  line-height: 1.6;
  color: #5b5b6b !important;
}
.pse-hero .pse-hero-sub strong { color: #16142a !important; font-weight: 700; }

/* Bouton SIMPLE : NOIR à la base, BLEU au survol */
#hero-section .pse-hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 4px;
