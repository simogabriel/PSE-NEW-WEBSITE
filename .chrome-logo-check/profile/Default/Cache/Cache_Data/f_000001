  background:
    linear-gradient(180deg, transparent 0%, rgba(2, 10, 24, .18) 18%, rgba(2, 10, 24, .94) 100%) !important;
  text-shadow:
    0 2px 3px rgba(0, 0, 0, .82),
    0 8px 24px rgba(0, 0, 0, .62) !important;
  -webkit-font-smoothing: antialiased;
  text-wrap: balance;
  overflow-wrap: anywhere;
}

@media (max-width: 809px) {
  [data-framer-name="Section Recent Articles"] .pse-carousel-image-caption {
