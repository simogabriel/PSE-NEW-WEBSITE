/* ================================================================
 *  CHARTE COULEUR PSE — tout en BLEU #348ace, plus aucun VIOLET
 *  Le template Framer définit ses couleurs via des "tokens" (variables
 *  CSS posées sur <body>). On les redéfinit ici => toutes les teintes
 *  violettes deviennent bleues partout, d'un seul coup.
 * ================================================================ */
body {
  /* violet vif #7d3bf4  -> bleu marque */
  --token-31295925-2a16-47c8-bb02-9dde316b47d1: #348ace !important;
  /* violet foncé #1a0f3a (fonds sombres) -> bleu nuit (pas de violet) */
  --token-4904ad93-0af3-4d66-8943-5858e4bdc968: #0c2034 !important;
  /* violet clair #af9aff -> bleu clair */
  --token-8c7c781d-94d9-47bb-a4bd-71593b452083: #8fc1e8 !important;
  /* lavande #d7d9ff -> bleu très clair */
  --token-fb8be2a8-a40c-4bd7-8214-44805d1d6f40: #dceaf6 !important;
}

/* Liens accent du template (bleu clair #0099ff) -> bleu marque unique */
a, .framer-text, p, span {
  --framer-link-text-color: #348ace !important;
}

/* ================================================================
 *  SECTION « ACTUALITÉS » — CARROUSEL (réf. image client P6.png)
 *  JS : pse-custom/news-carousel.js (ajoute .pse-news* + les boutons).
 * ================================================================ */

/* 1) On retire le gros paragraphe d'intro (« Explorez nos dernières
   analyses… »). CSS = permanent, Framer ne peut pas le réécrire. */
[data-framer-name="Section Recent Articles"] [data-framer-name="Text Content Wrap"] {
  display: none !important;
}

/* 2) Piste horizontale défilable (au lieu de la grille 2 colonnes). */
.pse-news-track {
  box-sizing: border-box !important;
  display: flex !important;
  flex-wrap: nowrap !important;
  gap: 28px !important;
  overflow-x: auto;
  max-width: 100% !important;
  overscroll-behavior-x: contain;
  scroll-padding-inline: 2px;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;            /* Firefox : pas de barre */
  padding: 38px 28px 72px !important;
}
.pse-news-track::-webkit-scrollbar { display: none; }  /* WebKit : idem */

/* 3) Chaque carte : large + coins très arrondis (comme l'image), de
   sorte que deux cartes débordent => effet carrousel avec aperçu. */
.pse-news-card {
  --pse-news-card-radius: clamp(48px, 5.5vw, 68px);
  --pse-news-image-radius: var(--pse-news-card-radius);
  --pse-news-frame-width: 6px;
  box-sizing: border-box !important;
  flex: 0 0 auto !important;
  max-width: 100% !important;
  min-width: 0 !important;
  width: clamp(300px, 64%, 640px) !important;
  padding: 0 !important;
  margin: 0 !important;
  background-color: transparent !important;
  background-image: none !important;
  border: var(--pse-news-frame-width) solid transparent !important;
  border-radius: var(--pse-news-card-radius) !important;
  outline: 0 !important;
  box-shadow: none !important;
  transform: translateY(-5px);
  height: auto !important;
  overflow: visible !important;
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

/* Keep each card as an image + title stack without altering the image crop. */
.pse-news-card > [data-framer-name="Desktop"],
.pse-news-card > [data-framer-name="Mobile"] {
  flex-direction: column !important;
  align-items: stretch !important;
  justify-content: flex-start !important;
  min-height: 0 !important;
}

/* Conteneur transparent : aucun cadre blanc autour de la photo. */
.pse-news-card [data-framer-name="Desktop"],
.pse-news-card [data-framer-name="Mobile"] {
  box-sizing: border-box !important;
  width: calc(100% + var(--pse-news-frame-width) + var(--pse-news-frame-width)) !important;
  height: auto !important;
  margin: calc(0px - var(--pse-news-frame-width)) !important;
  padding: 0 !important;
  gap: 0 !important;
  background-color: transparent !important;
  background-image: none !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  border-radius: var(--pse-news-card-radius) !important;
  overflow: visible !important;
}
.pse-news-card [data-framer-name="Image"] {
  background-color: transparent !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
}

.pse-news-card::before,
.pse-news-card::after,
.pse-news-card [data-framer-name="Desktop"]::before,
.pse-news-card [data-framer-name="Desktop"]::after,
.pse-news-card [data-framer-name="Mobile"]::before,
.pse-news-card [data-framer-name="Mobile"]::after {
  content: none !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

@media (min-width: 1440px) {
  .pse-news-card { width: calc(50% - 14px) !important; }
}

@media (min-width: 810px) and (max-width: 1199px) {
  .pse-news-card { width: 100% !important; }
}

/* Tablettes et téléphones : le carrousel défile verticalement. */
@media (max-width: 1199px) {
  .pse-news-track {
    flex-direction: column !important;
    height: clamp(360px, 65vh, 620px) !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    overscroll-behavior-x: auto;
    overscroll-behavior-y: contain;
    scroll-snap-type: y mandatory;
    scroll-padding-inline: 0;
    scroll-padding-block: 2px;
  }
  .pse-news-card { width: 100% !important; }
  .pse-news-prev svg,
  .pse-news-next svg { transform: rotate(90deg); }
}

@media (max-width: 809px) {
  .pse-news-track { gap: 18px !important; }
  .pse-news-card { width: 100% !important; }
  .pse-news-controls { justify-content: center !important; margin-top: 22px !important; }
}

@media (max-width: 479px) {
  .pse-news-track { gap: 14px !important; height: clamp(300px, 58vh, 500px) !important; }
  .pse-news-card { width: 100% !important; }
  .pse-news-card [data-framer-name="Blog Image Wrap"] { aspect-ratio: 4 / 3 !important; }
  .pse-news-nav { height: 44px !important; width: 44px !important; }
}

/* Très grands coins sur la carte, coins distincts sur la photo imbriquée. */
.pse-news-card [data-framer-name="Desktop"],
.pse-news-card [data-framer-name="Mobile"] {
  border-radius: var(--pse-news-card-radius) !important;
}
.pse-news-card [data-framer-name="Blog Image Wrap"] {
  border-radius: var(--pse-news-image-radius) !important;
  margin: 0 !important;
  padding: 0 !important;
}
.pse-news-card [data-framer-name="Blog Image Wrap"] { overflow: hidden !important; }

.pse-news-card [data-framer-name="Blog Image Wrap"],
.pse-news-card [data-framer-name="Image"],
.pse-news-card [data-framer-name="Image"] > div,
.pse-news-card [data-framer-name="Blog Image Wrap"] img {
  border-radius: var(--pse-news-image-radius) !important;
  clip-path: inset(0 round var(--pse-news-image-radius)) !important;
  overflow: hidden !important;
}

/* Cadrage des vraies photos PSE : zone d'image au ratio fixe, photo
   recadrée proprement (centrée, sans déformation) pour rester lisible. */
.pse-news-card [data-framer-name="Blog Image Wrap"] {
  aspect-ratio: 3 / 2 !important;
  display: block !important;
  flex: 0 0 auto !important;
  order: 1 !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  position: relative !important;
  background-color: transparent !important;
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-clip: padding-box !important;
  border: 0 !important;
  border-radius: var(--pse-news-image-radius) !important;
  box-shadow: none !important;
  overflow: hidden !important;
  overflow: clip !important;
  isolation: isolate;
  transform: translateZ(0);
  -webkit-mask-image: -webkit-radial-gradient(white, black);
  visibility: visible !important;
  opacity: 1 !important;
}
.pse-news-card [data-framer-name="Image"],
.pse-news-card [data-framer-name="Image"] > div,
.pse-news-card [data-framer-name="Blog Image Wrap"] img {
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  border-radius: inherit !important;
  overflow: hidden !important;
}
.pse-news-card [data-framer-name="Image"],
.pse-news-card [data-framer-name="Image"] > div {
  position: absolute !important;
  inset: 0 !important;
  background-color: transparent !important;
}
.pse-news-card [data-framer-name="Blog Image Wrap"] img {
  object-fit: cover !important;
  object-position: center !important;
  display: block !important;
}

/* Description displayed over each image. It does not capture interactions, so
   links, swiping, scrolling, autoplay and carousel controls keep working. */
.pse-carousel-image-caption {
  position: absolute !important;
  z-index: 5 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: flex-end !important;
  min-height: 42% !important;
  margin: 0 !important;
  padding: clamp(22px, 4vw, 42px) !important;
  color: #fff !important;
  background: linear-gradient(180deg, transparent 0%, rgba(3, 13, 28, .2) 20%, rgba(3, 13, 28, .88) 100%) !important;
  font-family: Geist, Inter, system-ui, sans-serif !important;
  font-size: clamp(18px, 2.1vw, 30px) !important;
  font-weight: 600 !important;
  line-height: 1.2 !important;
  letter-spacing: -.02em !important;
  text-align: left !important;
  text-shadow: 0 2px 12px rgba(0, 0, 0, .72) !important;
  pointer-events: none !important;
  user-select: none !important;
}

/* Home carousel captions: strong native system typography. */
[data-framer-name="Section Recent Articles"] .pse-carousel-image-caption {
  font-family: Archivo, "Archivo Placeholder", Geist, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  font-size: clamp(20px, 2.35vw, 34px) !important;
  font-weight: 700 !important;
