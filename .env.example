# Configure these in Vercel Project Settings > Environment Variables.
KV_REST_API_URL=https://your-upstash-redis-url
KV_REST_API_TOKEN=replace-with-your-upstash-token
# Alternatively, use UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
CAREERS_ADMIN_TOKEN=replace-with-a-long-random-secret
VAPID_PUBLIC_KEY=replace-with-web-push-public-key
VAPID_PRIVATE_KEY=replace-with-web-push-private-key
VAPID_SUBJECT=mailto:info@pse-consulting.com
